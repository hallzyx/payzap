# Optional campaign intent extraction. Without either key, a text parser is used.
# AI_PROVIDER=deepseek | openai
# If unset and both keys exist, DeepSeek Flash is used.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# PayPal Sandbox. When both are set, Generate Live Demo and Fresh live run
# open 10 real $1,000 captures on their own. Preview mode if unset.
# The Sandbox app needs Advanced Credit and Debit Card Payments enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional manual import for npm run seed:paypal. The running demo does not read this.
# PAYPAL_CAPTURE_IDS=
